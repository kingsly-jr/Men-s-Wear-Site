# PostgreSQL Connection Strings
# Example local PostgreSQL: postgresql://postgres:YOUR_PASSWORD@localhost:5432/crimson_terminal_store?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crimson_terminal_store?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crimson_terminal_store?schema=public"

# Session & Cryptographic Signing Secret (minimum 32 characters in production)
AUTH_SECRET="replace-with-a-cryptographically-random-32-plus-char-secret"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Controlled Initial Admin Seed Credentials (used only by prisma/seed.ts)
ADMIN_SEED_EMAIL="admin@crimsonterminal.store"
ADMIN_SEED_PASSWORD="ChangeMeImmediately123!"
ADMIN_SEED_NAME="Chief Store Administrator"
